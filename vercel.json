{
  "framework": "vite",
  "rewrites": [
    {
      "source": "/kinland(.*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(.*Discordbot.*|.*TelegramBot.*|.*Twitterbot.*)"
        }
      ],
      "destination": "/kinland-og.html"
    }
  ]
}
